#!/bin/bash
# Pre-commit hook: blocks commits that add AI-generated images.
# Install: cp hooks/pre-commit-sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Override: git commit --no-verify
IMAGES=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.(jpg|jpeg|png|webp)$')
[ -z "$IMAGES" ] && exit 0
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FAILED=0
for img in $IMAGES; do
  [ -f "$img" ] || continue
  score=$(python3 "$SCRIPT_DIR/ai-detector/detector.py" "$img" 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('total_score',0))" 2>/dev/null)
  if [ -n "$score" ] && [ "$(echo "$score > 0.6" | bc -l 2>/dev/null || echo 0)" = "1" ]; then
    echo "WARNING: $img scored $score (AI likely)" >&2
    FAILED=1
  fi
done
[ "$FAILED" = "1" ] && echo "Commit blocked. Run scan:ai:fix or use --no-verify." >&2 && exit 1
exit 0
